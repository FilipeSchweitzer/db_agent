# Copie para .env e preencha antes de subir o container.
# Nenhum backend de LLM é obrigatório no código: escolha um aqui.

# ---------------- LLM ----------------
# openai    -> qualquer endpoint compatível com a API OpenAI (padrão)
# ollama    -> atalho para o Ollama local (LLM_BACKEND=local também é aceito)
# anthropic -> opcional; exige: pip install "migra-agent[anthropic]"
#
# ATENÇÃO (LGPD): se o discovery encontrar PII, só backend local é aceito.
# `local`/`ollama`, ou `openai` com LLM_BASE_URL em host interno/privado.
# Backend remoto com PII interrompe a execução antes de qualquer chamada.
LLM_BACKEND=openai

# Backend openai — use UM dos dois caminhos:

# (a) endpoint remoto (OpenAI, OpenRouter, ...)
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=

# (b) endpoint local compatível com OpenAI (Ollama, vLLM, LM Studio...)
# LLM_BASE_URL=http://ollama:11434/v1
# LLM_API_KEY=not-needed
# LLM_MODEL=qwen2.5:14b-instruct-q4_K_M

# Backend ollama (atalho: preenche base_url/model/pseudo-chave)
OLLAMA_BASE_URL=http://ollama:11434/v1
OLLAMA_MODEL=qwen2.5:14b-instruct-q4_K_M

# Backend anthropic (opcional)
# ANTHROPIC_API_KEY=

# ---------------- Robustez / custo ----------------
# Tentativas por chamada e backoff exponencial (segundos).
LLM_MAX_ATTEMPTS=3
LLM_BACKOFF_BASE=1.0
LLM_BACKOFF_MAX=8.0
# Teto de tokens de saída por chamada.
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.0

# ---------------- Bancos ----------------
# Senhas nunca ficam no project.yaml.
SOURCE_DB_PASSWORD=
TARGET_DB_PASSWORD=

# ---------------- Governança ----------------
# Quem aprova o mapeamento. Também aceita `generate --approved-by "nome"`.
# Vai para auditoria.json e relatorio.md.
MIGRA_APPROVER=
