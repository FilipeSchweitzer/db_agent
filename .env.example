# Copie para .env e preencha antes de subir o container
# ----------------------------------------------------

# Qual cliente/projeto esta instância está processando
# (precisa existir uma pasta config/<nome>/ com project.yaml e target_schema.yaml)
CLIENT_PROJECT=example-client

# cloud -> usa a Anthropic API
# local -> usa o container ollama (sobe com --profile local)
LLM_BACKEND=cloud

# Necessário apenas se LLM_BACKEND=cloud
ANTHROPIC_API_KEY=

# Necessário apenas se LLM_BACKEND=local
OLLAMA_BASE_URL=http://ollama:11434/v1
OLLAMA_MODEL=qwen2.5:14b-instruct-q4_K_M
